{
  "name": "flowiter",
  "version": "0.2.3",
  "description": "Flowiter — 所見即所得的 Markdown 編輯器",
  "main": "./out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test"
  },
  "dependencies": {
    "abcjs": "^6.4.4",
    "@coderline/alphatab": "^1.8.2",
    "verovio": "^6.4.1",
    "@sightread/lilypond-wasm": "^0.2.0",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.0",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource-variable/source-serif-4": "^5.2.0",
    "@lezer/highlight": "^1.2.1",
    "@milkdown/crepe": "^7.5.0",
    "@milkdown/kit": "^7.5.0",
    "@playwright/test": "^1.55.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.3.0",
    "docx": "^9.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "@coderline/alphatab-vite": "^1.8.1",
    "electron-vite": "^4.0.0",
    "jsdom": "^26.1.0",
    "katex": "^0.16.11",
    "mermaid": "^11.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-highlight": "^7.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.6.0",
    "unified": "^11.0.5",
    "vite": "^6.0.0",
    "vitest": "^3.2.4",
    "remark-stringify": "^11.0.0"
  },
  "build": {
    "appId": "app.flowiter.editor",
    "productName": "Flowiter",
    "files": [
      "out/**",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "resources/ambient",
        "to": "ambient",
        "filter": [
          "**/*",
          "!README.md"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "chankaikai",
        "repo": "Flowriter"
      }
    ]
  },
  "author": "Flowiter <kaikai122148@163.com>",
  "homepage": "https://github.com/chankaikai/Flowriter"
}
